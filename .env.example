# Fluxito bootstrap configuration (hybrid model).
#
# .env is only for values Fluxito needs before it can connect to the database
# or complete first sign-in. Everything else is configured in the web UI after
# the first admin signs in: Settings -> Integrations for OAuth apps and
# Settings -> System for email, observability, rate limits, storage, and CORS.
#
# Usage:
#   cp .env.example .env
#   docker compose up -d
#   open http://localhost:8000
#
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# See README.md -> Configuration for the full model.

# Required signing/encryption secrets. If omitted, first boot writes generated
# values to .env.local (gitignored). For production, set them explicitly.
APP_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Required infrastructure.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fluxito
REDIS_URL=redis://localhost:6379/0

# Required public URL and MCP redirect allow-list.
APP_BASE_URL=http://localhost:8000
MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Last special-case OAuth app. Google powers both login and Google-family
# connectors; all other platform OAuth apps are configured in Settings -> Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Self-update ──────────────────────────────────────────────────────────
# Image tag the app runs. Leave as 'latest'; the in-app updater pins this
# to a specific version when you click "Update now".
FLUXITO_VERSION=latest
# Shared secret between the app and the updater sidecar. Generate a random value:
#   openssl rand -hex 32
# Leave blank to disable in-app self-update (the app still runs normally).
UPDATER_TOKEN=
# Internal URL of the updater sidecar (do not expose this port publicly).
UPDATER_URL=http://updater:9000
