# fluxito-nginx: nginx with the Fluxito reverse-proxy config baked in, so the
# standalone (no-clone) compose needs no host config file. Static is proxied to
# the app — nothing is served from a host mount.
FROM nginx:alpine

COPY nginx.conf /etc/nginx/nginx.conf

# Validate the baked config at build time. The upstream `app` host isn't
# resolvable during build, so swap it for 127.0.0.1 in a throwaway copy of
# the config, run the syntax test, then restore the real config.
RUN cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.bak \
    && sed -i 's/server app:/server 127.0.0.1:/g' /etc/nginx/nginx.conf \
    && nginx -t \
    && mv /etc/nginx/nginx.conf.bak /etc/nginx/nginx.conf
