  {
    "tool": "tagmanager_write",
    "action": "create_tag",
    "summary": "Create a GTM tag in a workspace. Requires GTM edit.containers scope.",
    "group": "GTM",
    "params": [
      {
        "name": "account_id",
        "type": "string",
        "required": true,
        "example": "6001234567",
        "doc": "GTM account ID."
      },
      {
        "name": "container_id",
        "type": "string",
        "required": true,
        "example": "12345678",
        "doc": "GTM container ID."
      },
      {
        "name": "name",
        "type": "string",
        "required": true,
        "example": "GA4 - Purchase",
        "doc": "Tag name (NOT validated at tool level; required by GTM API)."
      },
      {
        "name": "type",
        "type": "string",
        "required": true,
        "example": "gaawe",
        "doc": "GTM tag type code, e.g. gaawe (GA4 event), googtag, html, awct (NOT validated at tool level)."
      },
      {
        "name": "workspace_id",
        "type": "string",
        "required": false,
        "example": "3",
        "doc": "Workspace ID. NOTE: write tool default is None (not '0'); a None workspace_id builds an invalid GTM path '.../workspaces/None/...'."
      },
      {
        "name": "parameters",
        "type": "array",
        "required": false,
        "item_type": "object",
        "example": [
          {
            "key": "eventName",
            "value": "purchase"
          },
          {
            "key": "measurementIdOverride",
            "value": "G-XXXX"
          }
        ],
        "doc": "array of GTM parameter objects ({key, type?, value|list}); defaults to []."
      },
      {
        "name": "firing_trigger_ids",
        "type": "array",
        "required": false,
        "item_type": "string",
        "example": [
          "123",
          "2147479553"
        ],
        "doc": "array of trigger ID strings; defaults to []. Doc says required but code passes [] when omitted (tag would never fire)."
      },
      {
        "name": "blocking_trigger_ids",
        "type": "array",
        "required": false,
        "item_type": "string",
        "example": [
          "456"
        ],
        "doc": "array of blocking trigger ID strings; defaults to [] in connector."
      },
      {
        "name": "platform",
        "type": "string",
        "required": false,
        "enum": [
          "gtm",
          "adobe_launch"
        ],
        "example": "gtm",
        "doc": "Tag platform."
      }
    ],
    "platforms": [
      "gtm"
    ],
    "returns": "{ tag_id, tag_name, tag_type, workspace_id } | scope error | wrapped GTM API error",
    "scope": "tagmanager.edit.containers",
    "reversible": true
  },
  {
    "tool": "tagmanager_write",
    "action": "create_trigger",
    "summary": "Create a GTM trigger in a workspace. Requires GTM edit.containers scope.",
    "group": "GTM",
    "params": [
      {
        "name": "account_id",
        "type": "string",
        "required": true,
