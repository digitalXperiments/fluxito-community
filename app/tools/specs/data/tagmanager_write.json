  {
    "tool": "tagmanager_write",
    "action": "propose_change",
    "summary": "Dry-run: render a human-readable proposal from a spec dict without mutating anything (safe for read-only users; bypasses scope check).",
    "group": "GTM",
    "params": [
      {
        "name": "spec",
        "type": "object",
        "required": true,
        "example": {
          "entity_type": "tag",
          "name": "GA4 Purchase",
          "change_type": "create",
          "changes": {
            "tag_type": "gaawe",
            "firing_trigger_ids": [
              "123"
            ],
            "parameters": [
              {
                "key": "eventName",
                "value": "purchase"
              }
            ]
          }
        },
