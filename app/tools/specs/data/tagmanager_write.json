[
  {
    "tool": "tagmanager_write",
    "action": "add_resources_to_library",
    "summary": "Attach resources (rule/data-element/extension revisions) to an Adobe Launch library. Requires platform=adobe_launch.",
    "group": "ADOBE LAUNCH",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "adobe_launch"
        ],
        "example": "adobe_launch",
        "doc": "MUST be passed as adobe_launch."
      },
      {
        "name": "config",
        "type": "object",
        "required": true,
        "example": {
          "library_id": "LB1234abcd",
          "resources": [
            {
              "id": "RR1234",
              "type": "resources"
            }
          ]
        },
        "doc": "config.library_id and config.resources (non-empty array) are required. resources is an array of resource-revision reference objects."
      }
    ],
    "platforms": [
      "adobe_launch"
    ],
    "returns": "{ ...library } | no_adobe_launch_response | {error,message}",
    "scope": "no scope gate (connection presence only)",
    "reversible": true
  },
