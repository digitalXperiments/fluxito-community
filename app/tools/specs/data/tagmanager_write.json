        "example": "Purchase Click",
        "doc": "Trigger name (NOT validated at tool level)."
      },
      {
        "name": "type",
        "type": "string",
        "required": true,
        "example": "customEvent",
        "doc": "GTM trigger type, e.g. customEvent, click, pageview (NOT validated at tool level)."
      },
      {
        "name": "workspace_id",
        "type": "string",
        "required": false,
        "example": "3",
        "doc": "Workspace ID (write default None)."
      },
      {
        "name": "filters",
        "type": "array",
        "required": false,
        "item_type": "object",
        "example": [
          {
            "type": "equals",
            "parameter": [
              {
                "key": "arg0",
                "value": "{{Click Text}}"
              },
              {
                "key": "arg1",
                "value": "Buy"
              }
            ]
          }
        ],
        "doc": "array of GTM filter condition objects; connector defaults to []. Maps to GTM body 'filter'."
      },
      {
        "name": "platform",
        "type": "string",
        "required": false,
        "enum": [
          "gtm",
          "adobe_launch"
        ],
        "example": "gtm",
        "doc": "Tag platform."
      }
    ],
    "platforms": [
      "gtm"
    ],
    "returns": "{ trigger_id, trigger_name, trigger_type, workspace_id } | scope error | wrapped GTM API error",
    "scope": "tagmanager.edit.containers",
    "reversible": true
  },
