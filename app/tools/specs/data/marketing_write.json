  {
    "tool": "marketing_write",
    "action": "marketo_request_campaign",
    "summary": "Adobe Marketo: trigger a smart campaign to run against specified leads (with optional my.tokens).",
    "group": "ADOBE MARKETO ENGAGE",
    "params": [
      {
        "name": "resource_id",
        "type": "string",
        "required": true,
        "example": "3001",
        "doc": "Marketo campaign id."
      },
      {
        "name": "payload",
        "type": "object",
        "required": true,
        "example": {
          "lead_ids": [
            "1001"
          ],
          "tokens": [
            {
              "name": "{{my.x}}",
              "value": "v"
            }
          ]
        },
        "doc": "payload.lead_ids (array) REQUIRED; payload.tokens (array of objects) optional."
      }
    ],
    "platforms": [
      "marketo"
    ],
    "returns": "Raw Marketo REST envelope | error",
    "reversible": false
  },
  {
    "tool": "marketing_write",
    "action": "marketo_schedule_campaign",
    "summary": "Adobe Marketo: schedule a batch campaign to run at a time (with optional tokens).",
    "group": "ADOBE MARKETO ENGAGE",
    "params": [
      {
        "name": "resource_id",
        "type": "string",
        "required": true,
        "example": "3001",
        "doc": "Marketo campaign id."
      },
      {
        "name": "payload",
        "type": "object",
        "required": false,
        "example": {
          "run_at": "2026-07-01T09:00:00Z",
          "tokens": [
            {
              "name": "{{my.x}}",
              "value": "v"
            }
          ]
        },
        "doc": "payload.run_at (ISO datetime) optional, payload.tokens (array) optional."
      }
    ],
    "platforms": [
      "marketo"
    ],
    "returns": "Raw Marketo REST envelope | error",
    "reversible": false
  },
  {
    "tool": "marketing_write",
    "action": "marketo_upsert_leads",
    "summary": "Adobe Marketo: POST /rest/v1/leads.json \u2014 create or update leads in bulk.",
    "group": "ADOBE MARKETO ENGAGE",
    "params": [
      {
        "name": "payload",
        "type": "object",
        "required": true,
        "example": {
          "leads": [
            {
              "email": "a@b.com",
              "firstName": "A"
            }
          ],
          "lookup_field": "email",
          "action": "createOrUpdate"
        },
        "doc": "payload.leads (array of objects) is REQUIRED. payload.lookup_field (default 'email'), payload.action (default 'createOrUpdate')."
      }
    ],
    "platforms": [
      "marketo"
    ],
    "returns": "Raw Marketo REST envelope { result:[{id, status}] } | error",
    "reversible": false
  },
  {
    "tool": "marketing_write",
    "action": "update_campaign_budget",
    "summary": "Change a campaign's daily budget. Mutates live ad spend. Google converts USD\u2192micros; Snap/X/Reddit\u2192micros; TikTok/LinkedIn/Pinterest passes USD as-is; Meta converts to cents; Apple uses {amount, currency}.",
    "group": "PAID ADS (Google / Meta / TikTok / Snap / LinkedIn / Pinterest / X / Reddit / Apple)",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "google",
          "meta",
          "tiktok",
          "snap",
          "linkedin",
          "pinterest",
          "x",
          "reddit",
          "apple"
        ],
        "example": "google",
        "doc": "All 9 ad platforms now implement update_campaign_budget."
      },
      {
        "name": "account_id",
        "type": "string",
        "required": true,
        "example": "123-456-7890",
        "doc": "Ad account id. Validated up front for all non-marketo platforms (returns bad_request before action check)."
      },
      {
        "name": "campaign_id",
        "type": "string",
        "required": true,
        "example": "987654321",
        "doc": "Campaign to modify."
      },
      {
        "name": "daily_budget_usd",
        "type": "number",
        "required": true,
        "example": 50.0,
        "doc": "New daily budget in USD. Google/Snap multiply by 1_000_000 (micros); TikTok uses raw USD."
      }
    ],
    "platforms": [
      "google",
      "meta",
      "tiktok",
      "snap",
      "linkedin",
      "pinterest",
      "x",
      "reddit",
      "apple"
    ],
    "returns": "Connector result (updated budget) | {error,...}",
    "scope": "Google: inline SCOPE_GA4_FULL (Full Access) check; other platforms: none beyond token presence",
    "reversible": false
  },
  {
    "tool": "marketing_write",
    "action": "update_campaign_status",
    "summary": "Enable/pause a campaign. Mutates live delivery. status is uppercased before the connector call (google/meta/tiktok/snap); linkedin/pinterest/x/reddit/apple pass status as-is.",
    "group": "PAID ADS (Google / Meta / TikTok / Snap)",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "google",
          "meta",
          "tiktok",
          "snap",
          "linkedin",
          "pinterest",
          "x",
          "reddit",
          "apple"
        ],
        "example": "google",
        "doc": "Supported on all 9 ad platforms."
      },
      {
        "name": "account_id",
        "type": "string",
        "required": true,
        "example": "123-456-7890",
        "doc": "Ad account id (validated up front)."
      },
      {
        "name": "campaign_id",
        "type": "string",
        "required": true,
        "example": "987654321",
        "doc": "Campaign to toggle."
      },
      {
        "name": "status",
        "type": "string",
        "required": true,
        "enum": [
          "ENABLED",
          "PAUSED"
        ],
        "example": "PAUSED",
        "doc": "Target state. google/meta/tiktok/snap call .upper() on it; other platforms pass it through verbatim (case-sensitivity inconsistency)."
      }
    ],
    "platforms": [
      "google",
      "meta",
      "tiktok",
      "snap",
      "linkedin",
      "pinterest",
      "x",
      "reddit",
      "apple"
    ],
    "returns": "Connector result (updated status) | {error,...}",
    "scope": "Google: inline SCOPE_GA4_FULL (Full Access) check; others: token presence only",
    "reversible": false
