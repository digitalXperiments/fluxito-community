[
  {
    "tool": "marketing_write",
    "action": "create_campaign",
    "summary": "Create a new campaign. Google requires channel type + budget + start; Meta reuses advertising_channel_type as objective; TikTok/Snap/etc. use it as objective_type. Irreversible (creates a live ad object).",
    "group": "PAID ADS (Google / Meta / TikTok / Snap / LinkedIn / Pinterest / X / Reddit / Apple)",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "google",
          "meta",
          "tiktok",
          "snap",
          "linkedin",
          "pinterest",
          "x",
          "reddit",
          "apple"
        ],
        "example": "google",
        "doc": "All 9 ad platforms now implement create_campaign."
      },
      {
        "name": "account_id",
        "type": "string",
        "required": true,
        "example": "123-456-7890",
        "doc": "Ad account / customer id (validated up front)."
      },
      {
        "name": "campaign_name",
        "type": "string",
        "required": true,
        "example": "Spring Sale",
        "doc": "Campaign name. Required for all platforms."
      },
      {
        "name": "advertising_channel_type",
        "type": "string",
        "required": false,
        "enum": [
          "SEARCH",
          "DISPLAY",
          "SHOPPING",
          "VIDEO",
          "PERFORMANCE_MAX",
          "OUTCOME_SALES",
          "OUTCOME_TRAFFIC",
          "OUTCOME_AWARENESS",
          "OUTCOME_ENGAGEMENT",
          "OUTCOME_LEADS",
          "OUTCOME_APP_PROMOTION",
          "TRAFFIC",
          "CONVERSIONS",
          "REACH",
          "VIDEO_VIEWS",
          "BRAND_AWARENESS",
          "WEBSITE_VISITS",
          "LEAD_GENERATION",
          "AWARENESS",
          "APP_INSTALLS",
          "WEBSITE_CLICKS",
          "ENGAGEMENT"
        ],
        "example": "SEARCH",
        "doc": "Google: channel type (SEARCH|DISPLAY|SHOPPING|VIDEO|PERFORMANCE_MAX). Meta: objective (OUTCOME_SALES|OUTCOME_TRAFFIC|...). TikTok: objective_type (TRAFFIC|CONVERSIONS|REACH|VIDEO_VIEWS). LinkedIn: objectiveType (BRAND_AWARENESS|WEBSITE_VISITS|LEAD_GENERATION). Pinterest: objective_type (AWARENESS|TRAFFIC|VIDEO_VIEWS). Snap: objective (APP_INSTALL|AWARENESS). X: objective (APP_INSTALLS|WEBSITE_CLICKS|ENGAGEMENT|VIDEO_VIEWS). Reddit/Apple: not used (omit or pass default).",
        "platforms": [
          "google",
          "meta",
          "tiktok",
          "linkedin",
          "pinterest",
          "snap",
          "x"
        ]
      },
      {
        "name": "daily_budget_usd",
        "type": "number",
        "required": false,
        "example": 100.0,
        "doc": "Required for Google (\u2192 micros). TikTok/Reddit use as-is or convert. Snap/X/Reddit convert to micro-USD. Meta/Apple/Pinterest/LinkedIn optional.",
        "platforms": [
          "google",
          "meta",
          "tiktok",
          "snap",
          "linkedin",
          "pinterest",
          "x",
          "reddit",
          "apple"
        ]
      },
      {
        "name": "start_date",
        "type": "string",
        "required": false,
        "example": "2026-06-01",
        "doc": "YYYY-MM-DD. Required for Google; optional for Snap/X.",
        "platforms": [
          "google",
          "snap",
          "x"
        ]
      },
      {
        "name": "end_date",
        "type": "string",
        "required": false,
        "example": "2026-06-30",
        "doc": "Google: optional end date."
      },
      {
        "name": "bidding_strategy_type",
        "type": "string",
        "required": false,
        "example": "MAXIMIZE_CLICKS",
        "doc": "Google: defaults to MAXIMIZE_CLICKS when omitted."
      },
      {
        "name": "status",
        "type": "string",
        "required": false,
        "enum": [
          "ACTIVE",
          "PAUSED",
          "ENABLED"
        ],
        "example": "PAUSED",
        "doc": "Meta/Snap/Reddit: defaults to PAUSED. LinkedIn/Pinterest: defaults to ACTIVE. Google/Apple: uses ENABLED/PAUSED. Apple uses ENABLED (not ACTIVE)."
      }
    ],
    "platforms": [
      "google",
      "meta",
      "tiktok",
      "snap",
      "linkedin",
      "pinterest",
      "x",
      "reddit",
      "apple"
    ],
    "returns": "Connector result (created campaign id) | {error,...}",
    "scope": "Google: inline SCOPE_GA4_FULL (Full Access) check; Meta: token presence only",
    "reversible": false
  },
  {
