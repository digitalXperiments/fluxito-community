  {
    "tool": "analytics_write",
    "action": "adobe_workspace_create_project",
    "summary": "Adobe-only: create an Analysis Workspace project. Prefer config{name, rsid, tables:[{metrics, dimension?}]}. Fluxito builds a valid Workspace definition (do NOT invent raw definition JSON). Optional date_range (thisMonth, last30Days, YYYY-MM-DD/YYYY-MM-DD). A raw definition is accepted if it already contains workspaces+version. Validates against the report suite before POST unless config.validate=false.",
    "group": "ADOBE WORKSPACE",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "ga4",
          "amplitude",
          "mixpanel",
          "posthog",
          "adobe_analytics"
        ],
        "example": "adobe_analytics",
        "doc": "Adobe only."
      },
      {
        "name": "config",
        "type": "object",
        "required": true,
        "example": {
          "name": "Weekly traffic",
          "rsid": "myrsid",
          "date_range": "thisMonth",
          "tables": [
            {
              "name": "Traffic",
              "metrics": ["visits", "pageviews"],
              "dimension": "page"
            }
          ]
        },
        "doc": "Required: name, rsid. Preferred: tables (array of {name?, metrics[], dimension?}) — Fluxito expands this into Adobe's Workspace JSON. Alternative: a full definition with workspaces+version. Incomplete definitions (e.g. {version:31} only) are expanded to a Visits/thisMonth template. Optional description, tags, shares, date_range, validate (default true)."
      },
      {
        "name": "config.description",
        "type": "string",
        "required": false,
        "example": "",
        "doc": "Optional project description."
      }
    ],
    "platforms": [
      "adobe_analytics"
    ],
    "returns": "{success, project_id, name, rsid, message} | {error,error_type,message,adobe_error_code?}",
    "scope": "analytics_write",
    "reversible": true
  },
  {
    "tool": "analytics_write",
