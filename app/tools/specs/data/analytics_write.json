  {
    "tool": "analytics_write",
    "action": "adobe_workspace_update_project",
    "summary": "Adobe-only: edit a Workspace project via Adobe's documented partial PUT. A rename is PUT {name}. To rebuild visualizations pass config.tables (Fluxito builds the definition). Set merge_definition=true to GET+merge a partial definition. project_id must match [A-Za-z0-9_-]{1,128}.",
    "group": "ADOBE WORKSPACE",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "ga4",
          "amplitude",
          "mixpanel",
          "posthog",
          "adobe_analytics"
        ],
        "example": "adobe_analytics",
        "doc": "Adobe only."
      },
      {
        "name": "config",
        "type": "object",
        "required": true,
        "example": {
          "project_id": "6091a10005c7706c0acdd751",
          "name": "Renamed project"
        },
        "doc": "Must contain a valid project_id (letters/digits/_/- only). Optional name, description, rsid, owner, definition, tables, date_range, tags, shares. tables rebuilds the Workspace definition (preferred over inventing raw definition JSON). Only writable fields are PUT."
      },
      {
        "name": "config.tables",
        "type": "array",
        "required": false,
        "item_type": "object",
        "example": [
          {
            "name": "Traffic",
            "metrics": ["visits"],
            "dimension": "page"
          }
        ],
        "doc": "Compact freeform tables. When set, Fluxito builds a full Workspace definition and PUTs it."
      },
      {
        "name": "config.name",
        "type": "string",
        "required": false,
        "example": "Renamed project",
        "doc": "Optional new name."
      },
      {
        "name": "config.description",
        "type": "string",
        "required": false,
        "example": "",
        "doc": "Optional new description."
      },
      {
        "name": "config.rsid",
        "type": "string",
        "required": false,
        "example": "myrsid",
        "doc": "Optional new report suite id."
      },
      {
        "name": "config.definition",
        "type": "object",
        "required": false,
        "example": {
          "version": "31"
        },
        "doc": "Definition object sent as-is in the partial PUT; it may replace the stored definition subtree (Adobe's partial-update contract is top-level, not a recursive merge inside definition). Use merge_definition=true when you only want to change nested fields and keep the rest of the stored definition."
      },
      {
        "name": "config.merge_definition",
        "type": "boolean",
        "required": false,
        "example": false,
        "doc": "Opt-in. When true and definition is provided, GET the current definition, deep-merge the caller's keys into that subtree, and PUT {definition: merged, ...other caller fields}. Never resends owner/type/modified or the full GET representation."
      },
      {
        "name": "config.owner",
        "type": "object",
        "required": false,
        "example": {
          "id": 622291
        },
        "doc": "Optional owner object sent as a caller-supplied partial-PUT field. Not fetched or merged from GET unless you include it here."
      }
    ],
    "platforms": [
      "adobe_analytics"
    ],
    "returns": "{success, project_id, name, rsid, updated_fields, merged_definition, message} | {error,error_type,message,adobe_error_code?}",
    "scope": "analytics_write",
    "reversible": true
  },
