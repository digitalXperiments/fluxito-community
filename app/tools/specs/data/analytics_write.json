    "summary": "Adobe-only: duplicate a Workspace project (GET source with definition, POST under a new name using writable fields only). Requires config{project_id, name}. project_id must match [A-Za-z0-9_-]{1,128}.",
    "group": "ADOBE WORKSPACE",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "ga4",
          "amplitude",
          "mixpanel",
          "posthog",
          "adobe_analytics"
        ],
        "example": "adobe_analytics",
        "doc": "Adobe only."
      },
      {
        "name": "config",
        "type": "object",
        "required": true,
        "example": {
          "project_id": "6091a10005c7706c0acdd751",
          "name": "Weekly traffic (copy)"
        },
        "doc": "Must contain a valid project_id (source; letters/digits/_/- only) and name (new project name). Copy posts only writable fields — never owner/type/created/modified from the GET."
      }
    ],
    "platforms": [
      "adobe_analytics"
    ],
    "returns": "{success, project_id, name, rsid, copied_from, message} | {error,error_type,message,adobe_error_code?}",
    "scope": "analytics_write",
    "reversible": true
  },
