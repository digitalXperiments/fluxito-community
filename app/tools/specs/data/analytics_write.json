[
  {
    "tool": "analytics_write",
    "action": "create_audience",
    "summary": "GA4-only: create an audience. Requires full analytics OAuth scope + config with display_name, membership_duration_days, filter_clauses.",
    "group": "",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "ga4",
          "amplitude",
          "mixpanel",
          "posthog",
          "adobe_analytics"
        ],
        "example": "ga4",
        "doc": "GA4 only."
      },
      {
        "name": "property_id",
        "type": "string",
        "required": true,
        "example": "properties/123456789",
        "doc": "GA4 property (auto-prefixed). Used by connector; NOT explicitly required-checked in this action (passed as-is, may be None).",
        "platforms": [
          "ga4"
        ]
      },
      {
        "name": "config",
        "type": "object",
        "required": true,
        "example": {
          "display_name": "Cart abandoners",
          "membership_duration_days": 30,
          "filter_clauses": []
        },
        "doc": "Must contain keys display_name, membership_duration_days, filter_clauses (existence-checked via 'k not in config', so falsy values like 0 are allowed)."
      },
      {
        "name": "config.description",
        "type": "string",
        "required": false,
        "example": "VIP segment",
        "doc": "Optional audience description."
      }
    ],
    "platforms": [
      "ga4"
    ],
    "returns": "GA4 create_audience dict | {error,message} | insufficient_scope error",
    "scope": "analytics_write",
    "reversible": true
  },
