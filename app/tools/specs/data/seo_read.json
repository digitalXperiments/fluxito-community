  {
    "tool": "seo_read",
    "action": "search_analytics",
    "summary": "Query GSC Search Analytics (impressions/clicks/CTR/position). Requires site_url + date range; dimensions/filters optional.",
    "group": "GOOGLE SEARCH CONSOLE",
    "params": [
      {
        "name": "site_url",
        "type": "string",
        "required": true,
        "example": "sc-domain:example.com",
        "doc": "GSC property \u2014 either a domain property `sc-domain:example.com` or a URL-prefix property `https://example.com/`. No format validation in this layer."
      },
      {
        "name": "start_date",
        "type": "string",
        "required": true,
        "example": "2026-05-01",
        "doc": "YYYY-MM-DD. Required."
      },
      {
        "name": "end_date",
        "type": "string",
        "required": true,
        "example": "2026-05-31",
        "doc": "YYYY-MM-DD. Required."
      },
      {
        "name": "dimensions",
        "type": "array",
        "required": false,
        "item_type": "string",
        "example": [
          "query"
        ],
        "doc": "Array of strings; subset of query|page|country|device|date|searchAppearance. Element type coerced to str via BeforeValidator(str). No enum enforcement here."
      },
      {
        "name": "search_type",
        "type": "string",
        "required": false,
        "example": "web",
        "doc": "web|image|video|news|discover|googleNews per docstring, but NOT enum-validated in code (plain CoercedStr)."
      },
      {
        "name": "row_limit",
        "type": "integer",
        "required": false,
        "example": 1000,
        "doc": "Default 1000. Docstring/SEO_READ_DOC claim 'max 25000' but no cap is enforced in this layer \u2014 passed straight to the connector."
      },
      {
        "name": "start_row",
        "type": "integer",
        "required": false,
        "example": 0,
        "doc": "Pagination offset."
      },
      {
        "name": "dimension_filter_groups",
        "type": "array",
        "required": false,
        "item_type": "object",
        "example": [],
        "doc": "Array of GSC dimensionFilterGroups objects; passed through unvalidated."
      },
      {
        "name": "aggregation_type",
        "type": "string",
        "required": false,
        "example": "auto",
        "doc": "GSC aggregationType (auto|byPage|byProperty); passed through unvalidated."
      },
      {
        "name": "data_state",
        "type": "string",
        "required": false,
        "example": "final",
        "doc": "Docstring says 'final'|'all'; not enum-validated."
      }
    ],
    "platforms": [
      "gsc"
    ],
    "returns": "await sc.search_analytics_query(...) \u2192 { rows: [{<dims>, clicks, impressions, ctr, position}], ... } | bad_request error",
    "scope": "seo_read"
  }
]
