    "tool": "seo_read",
    "action": "bing_get_query_stats",
    "summary": "Bing keyword/query performance stats. Requires site_url; date range + paging optional.",
    "group": "BING WEBMASTER TOOLS",
    "params": [
      {
        "name": "site_url",
        "type": "string",
        "required": true,
        "example": "https://example.com/",
        "doc": "Bing-verified site URL (full URL form; Bing has no sc-domain: notation)."
      },
      {
        "name": "start_date",
        "type": "string",
        "required": false,
        "example": "2026-05-01",
        "doc": "YYYY-MM-DD. Mapped to connector arg date_from."
      },
      {
        "name": "end_date",
        "type": "string",
        "required": false,
        "example": "2026-05-31",
        "doc": "YYYY-MM-DD. Mapped to connector arg date_to."
      },
      {
        "name": "search_type",
        "type": "string",
        "required": false,
        "example": "web",
        "doc": "Free-form string, not enum-validated."
      },
      {
        "name": "page",
        "type": "integer",
        "required": false,
        "example": 0,
        "doc": "Page index for pagination (default 0)."
      },
      {
        "name": "page_size",
        "type": "integer",
        "required": false,
        "example": 100,
        "doc": "Rows per page (default 100)."
      }
    ],
    "platforms": [
      "bing"
    ],
    "returns": "await connector.get_query_stats(...) \u2192 connector dict | bad_request error",
    "scope": "seo_read"
  },
