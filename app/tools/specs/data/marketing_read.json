  {
    "tool": "marketing_read",
    "action": "get_campaign_performance",
    "summary": "Per-campaign performance metrics for a date range; metrics[] customizable, cached 60s.",
    "group": "PAID ADS (Google / Meta / TikTok / Snap)",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "google",
          "meta",
          "tiktok",
          "snap",
          "linkedin",
          "pinterest",
          "x",
          "reddit",
          "apple"
        ],
        "example": "google",
        "doc": "Ad platform."
      },
      {
        "name": "account_id",
        "type": "string",
        "required": true,
        "example": "123-456-7890",
        "doc": "Ad account / customer id. Required for all non-list_accounts actions."
      },
      {
        "name": "date_range_start",
        "type": "string",
        "required": false,
        "example": "2026-05-01",
        "doc": "YYYY-MM-DD. NOT validated by the tool \u2014 silently passed as None to the connector if omitted (connector then builds a malformed query)."
      },
      {
        "name": "date_range_end",
        "type": "string",
        "required": false,
        "example": "2026-05-31",
        "doc": "YYYY-MM-DD. Not validated by the tool layer."
      },
      {
        "name": "metrics",
        "type": "array",
        "required": false,
        "item_type": "string",
        "example": [
          "clicks",
          "impressions",
          "cost_micros"
        ],
        "doc": "array of strings. Google default = clicks,impressions,cost_micros,conversions,ctr,average_cpc when omitted."
      }
    ],
    "platforms": [
      "google",
      "meta",
      "tiktok",
      "snap"
    ],
    "returns": "{ campaigns: [ {campaign_id, campaign_name, campaign_type, status, ...metrics} ] } | {error,...}"
  },
