    "tool": "tagmanager_read",
    "action": "get_container_summary",
    "summary": "Container overview (counts, last-published, workspace count) for one container (cached 300s).",
    "group": "GTM",
    "params": [
      {
        "name": "account_id",
        "type": "string",
        "required": true,
        "example": "6001234567",
        "doc": "GTM account ID."
      },
      {
        "name": "container_id",
        "type": "string",
        "required": true,
        "example": "12345678",
        "doc": "GTM container ID."
      },
      {
        "name": "platform",
        "type": "string",
        "required": false,
        "enum": [
          "gtm",
          "adobe_launch"
        ],
        "example": "gtm",
        "doc": "Tag platform."
      }
    ],
    "platforms": [
      "gtm"
    ],
    "returns": "{ ...summary fields } | no_gtm_response | {error,message}"
  },
