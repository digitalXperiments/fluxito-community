  {
    "tool": "analytics_read",
    "action": "compare_date_ranges",
    "summary": "GA4-only: compare one or more metrics between a current and previous date range.",
    "group": "REPORTING",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "ga4",
          "amplitude",
          "mixpanel",
          "posthog",
          "adobe_analytics"
        ],
        "example": "ga4",
        "doc": "Must be ga4; amplitude/adobe have no compare_date_ranges handler."
      },
      {
        "name": "property_id",
        "type": "string",
        "required": true,
        "example": "properties/123456789",
        "doc": "GA4 property. Required.",
        "platforms": [
          "ga4"
        ]
      },
      {
        "name": "metrics",
        "type": "array",
        "required": true,
        "item_type": "object",
        "example": [
          "sessions"
        ],
        "doc": "Array of metric strings (object form coerced). Checked BEFORE dates."
      },
      {
        "name": "start_date",
        "type": "string",
        "required": true,
        "example": "2026-05-01",
        "doc": "Current range start (passed as current_start)."
      },
      {
        "name": "end_date",
        "type": "string",
        "required": true,
        "example": "2026-05-31",
        "doc": "Current range end (passed as current_end)."
      },
      {
        "name": "previous_start",
        "type": "string",
        "required": true,
        "example": "2026-04-01",
        "doc": "Previous range start."
      },
      {
        "name": "previous_end",
        "type": "string",
        "required": true,
        "example": "2026-04-30",
        "doc": "Previous range end."
      }
    ],
    "platforms": [
      "ga4"
    ],
    "returns": "GA4 connector compare_date_ranges dict (per-metric current/previous values + deltas) | {error,message}",
    "scope": "analytics_read"
  },
